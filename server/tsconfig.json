{
	"compilerOptions": {
		"target": "esnext",
		"lib": ["ESNext", "DOM"],
		"types": ["node"],
		"module": "nodenext",
		"moduleResolution": "nodenext",
		"sourceMap": true,
		"strict": true,
		"outDir": "out",
		"rootDir": "src"
	},
	"include": ["src"],
	"exclude": ["node_modules", ".vscode-test"]
}
