.vscode/**
.github/**
.gitignore
scripts/**
*.vsix
**/*.ts
**/*.map
**/tsconfig*.json
**/*.tsbuildinfo
# The client and server are bundled into packages/*/dist with their
# dependencies (see scripts/bundle.mjs), so neither the compiled sources nor
# node_modules are needed.
node_modules/**
packages/*/node_modules/**
packages/*/out/**
packages/*/src/**
packages/*/package.json
!packages/shared/src/language-configuration.json
!packages/client/src/zinnia.tmGrammar.json
