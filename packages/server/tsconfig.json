{
	"compilerOptions": {
		"target": "esnext",
		"lib": ["esnext", "dom"],
		"types": ["node"],
		"module": "nodenext",
		"moduleResolution": "nodenext",
		"sourceMap": true,
		"strict": true,
		"outDir": "out",
		"rootDir": "src",
    "composite": true,
		"paths": {"*": ["./src/*"]}
	},
  "include": ["src"],
}
