{
	"name": "zinnia-language",
	"description": "Zinnia Lanugage Support",
	"author": "Jeff Manzione",
	"license": "MIT",
	"version": "1.0.2",
	"repository": {
		"type": "git",
		"url": "https://github.com/jeffmanzione/zinnia-language-server"
	},
	"publisher": "jeffmanzione",
	"categories": [],
	"keywords": [
		"multi-root ready"
	],
	"engines": {
		"vscode": "^1.127.0"
	},
	"activationEvents": [],
	"main": "./packages/client/out/extension",
	"workspaces": [
		"packages/*"
	],
	"contributes": {
		"languages": [
			{
				"id": "zinnia",
				"aliases": [
					"Zinnia",
					"zn"
				],
				"extensions": [
					".zn"
				],
				"configuration": "./packages/shared/src/language-configuration.json"
			}
		],
		"grammars": [
			{
				"language": "zinnia",
				"scopeName": "source.zn",
				"path": "./packages/client/src/zinnia.tmGrammar.json"
			}
		],
		"configuration": {
			"type": "object",
			"title": "Configuration",
			"properties": {
				"zinnia.maxNumberOfProblems": {
					"scope": "resource",
					"type": "number",
					"default": 100,
					"description": "Controls the maximum number of problems produced by the server."
				},
				"zinnia.trace.server": {
					"scope": "window",
					"type": "string",
					"enum": [
						"off",
						"messages",
						"verbose"
					],
					"default": "off",
					"description": "Traces the communication between VS Code and the language server."
				},
				"zinnia.libraryPath": {
					"scope": "machine-overridable",
					"type": "string",
					"default": "",
					"description": "The directory of the Zinnia standard library to use, e.g. zinnia/lib in a checkout of zinnia. By default, the copy bundled with the extension is used. Restart the extension after changing this."
				}
			}
		}
	},
	"scripts": {
		"vscode:prepublish": "npm run compile",
		"compile": "npx tsc -b",
		"build": "npx vsce package --follow-symlinks",
		"watch": "npx tsc -b -w",
		"test": "npm run compile && node --test \"packages/server/out/test/**/*.test.js\""
	},
	"vsce": {},
	"dependencies": {
		"zinnia-language-shared": "file:../shared"
	},
	"devDependencies": {
		"@types/node": "^26.1.0",
		"typescript": "^6.0.3"
	}
}
