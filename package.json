{
	"name": "zinnia-language",
	"description": "Language support for Zinnia: highlighting, diagnostics, navigation, completion, refactoring and formatting",
	"author": "Jeff Manzione",
	"license": "MIT",
	"version": "0.0.0",
	"repository": {
		"type": "git",
		"url": "https://github.com/jeffmanzione/zinnia-language-server"
	},
	"publisher": "jeffmanzione",
	"categories": [
		"Programming Languages",
		"Linters",
		"Formatters"
	],
	"keywords": [
		"multi-root ready"
	],
	"engines": {
		"vscode": "^1.127.0"
	},
	"activationEvents": [],
	"main": "./packages/client/dist/extension.js",
	"workspaces": [
		"packages/*"
	],
	"contributes": {
		"languages": [
			{
				"id": "zinnia",
				"aliases": [
					"Zinnia",
					"zn"
				],
				"extensions": [
					".zn"
				],
				"configuration": "./packages/shared/src/language-configuration.json"
			}
		],
		"commands": [
			{
				"command": "zinnia.runFile",
				"title": "Run File",
				"category": "Zinnia"
			}
		],
		"menus": {
			"commandPalette": [
				{
					"command": "zinnia.runFile",
					"when": "editorLangId == zinnia"
				}
			]
		},
		"configurationDefaults": {
			"[zinnia]": {
				"editor.tabSize": 2,
				"editor.insertSpaces": true
			}
		},
		"grammars": [
			{
				"language": "zinnia",
				"scopeName": "source.zn",
				"path": "./packages/client/src/zinnia.tmGrammar.json"
			}
		],
		"configuration": {
			"type": "object",
			"title": "Configuration",
			"properties": {
				"zinnia.maxNumberOfProblems": {
					"scope": "resource",
					"type": "number",
					"default": 100,
					"description": "Controls the maximum number of problems produced by the server."
				},
				"zinnia.trace.server": {
					"scope": "window",
					"type": "string",
					"enum": [
						"off",
						"messages",
						"verbose"
					],
					"default": "off",
					"description": "Traces the communication between VS Code and the language server."
				},
				"zinnia.executable": {
					"scope": "machine-overridable",
					"type": "string",
					"default": "zinnia",
					"description": "The zinnia executable that the Run tests lens runs files with."
				},
				"zinnia.libraryPath": {
					"scope": "machine-overridable",
					"type": "string",
					"default": "",
					"description": "The directory of the Zinnia standard library to use, e.g. zinnia/lib in a checkout of zinnia. By default, the copy bundled with the extension is used. Restart the extension after changing this."
				}
			}
		}
	},
	"scripts": {
		"vscode:prepublish": "npm run compile && npm run bundle",
		"compile": "npx tsc -b",
		"bundle": "node scripts/bundle.mjs",
		"build": "npx --yes @vscode/vsce@4.0.0 package --no-dependencies",
		"watch": "node scripts/bundle.mjs --watch",
		"test": "npm run compile && node --test \"packages/server/out/test/**/*.test.js\""
	},
	"vsce": {},
	"dependencies": {
		"zinnia-language-shared": "file:../shared"
	},
	"devDependencies": {
		"@types/node": "^26.1.0",
		"esbuild": "0.28.2",
		"typescript": "^6.0.3"
	}
}
